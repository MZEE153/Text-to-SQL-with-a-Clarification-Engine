# TEMPLATE ONLY -- this file IS committed to git, so never put a real key or password here.
# Copy it to a file named exactly `.env` (git-ignored) and put the real values there.
# Only `.env` is read by python-dotenv's load_dotenv().

# Postgres superuser name (also used by docker-compose.yml to create the first user)
POSTGRES_USER=txt2sql_admin
# Postgres password: choose your own, in `.env` only
POSTGRES_PASSWORD=
# Name of the database created on first container start
POSTGRES_DB=txt2sql
# Host the Python code connects to (the Docker container is published on localhost)
POSTGRES_HOST=localhost
# Host port Docker maps to the container's 5432 (5433 avoids clashing with a local Postgres)
POSTGRES_PORT=5433

# Groq API key (console.groq.com/keys) -- used by sql_generator_groq.py
GROQ_API_KEY=
# Google AI Studio key -- used by the Gemini-based files (ambiguity_classifier.py, sql_generator.py)
GOOGLE_API_KEY=
# Hugging Face token -- used by the HF embedding model and the sql_generator_hf.py experiment
HUGGINGFACEHUB_API_TOKEN=
# LangSmith key -- for tracing, planned for Step 10
LANGSMITH_API_KEY=
# Switch LangSmith tracing on/off (false until Step 10)
LANGSMITH_TRACING=false
# LangSmith project name that traces are grouped under
LANGSMITH_PROJECT=txt2sql-clarification-engine
